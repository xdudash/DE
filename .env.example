# Copy to .env.local (git-ignored). Never commit real values: this repository is public.

# --- Supabase (learner data; ADR-0002). No project exists yet — see supabase/README.md.
# Public values, safe to expose to the browser:
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses row-level security: never expose to the client or to logs.
SUPABASE_SERVICE_ROLE_KEY=

# --- Local database tests (scripts/db_test.sh) against any PostgreSQL 15+
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
