# Copy to .env.local (git-ignored). Never commit real values: this repository is public.
# Hosted values belong in Vercel (docs/development/ACCOUNTS_SETUP.md, REMINDERS_SETUP.md).

# --- Sign-in (Supabase Auth; ADR-0013). Without URL and key, sign-in reports "not set up".
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Only for a project that still signs tokens with the legacy HS256 secret (or the local
# stack). Projects with signing keys are verified through their public JWKS: leave empty.
SUPABASE_JWT_SECRET=
# Server-only, needed for account deletion. Bypasses row-level security: never expose it.
SUPABASE_SERVICE_ROLE_KEY=
# Preview only: "1" shows the throwaway test sign-in. Refused on production.
AUTH_TEST_LOGIN=

# --- Learner data (ADR-0010). Without it, answers are checked but not stored.
DATABASE_URL=
# DATABASE_SSL=disable   # local PostgreSQL only
# DATABASE_POOL_MAX=

# --- Daily reminders (ADR-0015)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
CRON_SECRET=

# --- Local database tests (scripts/db_test.sh) against any PostgreSQL 15+
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
