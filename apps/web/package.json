{
  "name": "@deutschgo/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "content": "node --experimental-strip-types --no-warnings ../../packages/content-kit/src/cli/build.ts ../../content generated/content.json",
    "predev": "npm run content",
    "dev": "next dev",
    "prebuild": "npm run content",
    "build": "next build",
    "start": "next start",
    "typecheck": "npm run content && tsc --noEmit",
    "test": "node --test --experimental-strip-types \"test/**/*.test.ts\"",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@deutschgo/attempts": "*",
    "@deutschgo/content-kit": "*",
    "@deutschgo/gamification": "*",
    "@deutschgo/i18n": "*",
    "@deutschgo/learning-engine": "*",
    "next": "^16.0.0",
    "pg": "^8.16.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.18.0",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/web-push": "^3.6.4",
    "typescript": "^5.9.3"
  }
}
