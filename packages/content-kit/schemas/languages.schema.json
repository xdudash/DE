{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deutschgo.dev/schemas/languages.schema.json",
  "title": "DeutschGo explanation/interface language registry v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "languages"],
  "properties": {
    "schema": { "const": "deutschgo.languages/1" },
    "languages": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["code", "name", "native_name", "dir", "wave", "ui", "explanations"],
        "properties": {
          "code": { "type": "string", "pattern": "^[a-z]{2,3}(-[A-Z][a-z]{3})?$" },
          "name": { "type": "string" },
          "native_name": { "type": "string" },
          "dir": { "enum": ["ltr", "rtl"] },
          "wave": { "enum": [1, 2, 3] },
          "ui": { "type": "boolean" },
          "explanations": { "type": "boolean" },
          "pivot": { "type": "boolean" }
        }
      }
    }
  }
}
