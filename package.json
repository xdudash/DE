{
  "name": "deutschgo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": "^22.18.0"
  },
  "scripts": {
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "content:validate": "npm run validate -w @deutschgo/content-kit",
    "content:build": "npm run content -w @deutschgo/web",
    "build": "npm run build -w @deutschgo/web",
    "foundation": "node scripts/run-python.mjs scripts/foundation.py",
    "check": "npm run foundation && npm run typecheck && npm test && npm run content:validate && npm run build",
    "test:db": "bash scripts/db_test.sh",
    "content:report": "npm run report -w @deutschgo/content-kit"
  }
}
